# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
PRIMARY_ADMIN_EMAIL=admin@example.com
JWT_SECRET=replace-with-a-long-random-secret

# MySQL: use DATABASE_URL locally, or DB_* fields for Cloud SQL-compatible pooling.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/nyc_cleaning
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_POOL_LIMIT=5
# Cloud Run mounts Cloud SQL at this Unix socket path.
MYSQL_UNIX_SOCKET=

# Google Cloud Storage; when set, /manus-storage/* is served from this private bucket.
GCS_BUCKET=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=NYC Cleaning <notifications@example.com>

# Legacy storage fallback used only before cutover.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Legacy OAuth variables; the CMS uses its own password/session flow.
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
